{
  "manifest_version": 2,
  "name": "Claude for Zen",
  "version": "0.2.9",
  "description": "Lets Claude Code see, control and annotate tabs in Zen Browser / Firefox through a local MCP server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-for-zen@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity"
        ]
      },
      "update_url": "https://github.com/Ephpotle/claude-for-zen-releases/releases/latest/download/updates.json"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "tabs",
    "webRequest",
    "storage",
    "menus",
    "cookies",
    "scripting",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "markdown.js",
        "content.js",
        "overlay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "Claude for Zen",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    "overlay.css",
    "card.html",
    "card.js"
  ],
  "commands": {
    "comment": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Comment on part of the page for Claude"
    },
    "explain": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Explain the selected text"
    },
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+C"
      },
      "description": "Open the Claude for Zen chat sidebar"
    }
  },
  "sidebar_action": {
    "default_title": "Claude for Zen",
    "default_panel": "sidebar.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}
